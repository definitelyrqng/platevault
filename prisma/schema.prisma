datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum NotificationType {
  LIKE
  COMMENT
  UPLOAD_DELETED
  UPLOAD_FLAGGED
  MULTISPOT
  POLL
  SYSTEM
}

enum PollType {
  MONTHLY
  YEARLY
}

enum UserRole {
  SUPERADMIN  // user #0 only — created via CLI
  ADMIN
  MOD
  USER
}

model User {
  id        String   @id @default(cuid())
  numericId Int      @unique @default(autoincrement())
  role      UserRole @default(USER)

  username  String   @unique @db.VarChar(20)
  email     String   @unique @db.VarChar(254)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now())

  bio       String?  @db.VarChar(280)
  avatarUrl String?  @db.VarChar(500)
  bannerUrl String?  @db.VarChar(500)

  // Ban
  bannedAt     DateTime?
  banExpiresAt DateTime?          // null = permanent
  banReason    String?  @db.VarChar(500)

  sessions      Session[]
  uploads       Upload[]
  likes         Like[]
  comments      Comment[]
  notifications Notification[]
  pollVotes     PollVote[]

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(128)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Upload {
  id        String   @id @default(cuid())
  numericId Int      @unique @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  country   String   @db.VarChar(60)
  plateText String   @db.VarChar(32)
  plateType String?  @db.VarChar(60)

  brand      String? @db.VarChar(60)
  model      String? @db.VarChar(60)
  generation String? @db.VarChar(60)
  trim       String? @db.VarChar(60)
  color      String? @db.VarChar(60)

  location  String?  @db.VarChar(120)

  imageUrl  String   @db.VarChar(500)

  hidden    Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  likes         Like[]
  comments      Comment[]
  pollNominees  PollNominee[]

  @@index([userId, createdAt])
  @@index([country, createdAt])
  @@index([plateText])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  uploadId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  upload    Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([userId, uploadId])
  @@index([uploadId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  uploadId  String
  userId    String
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  upload    Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([uploadId, createdAt])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String           @db.VarChar(120)
  message   String?          @db.VarChar(280)
  url       String?          @db.VarChar(500)

  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Poll {
  id        String   @id @default(cuid())
  numericId Int      @unique @default(autoincrement())
  country   String   @db.VarChar(60)
  type      PollType
  year      Int
  month     Int      @default(0)  // 1-12 for MONTHLY, 0 for YEARLY
  opensAt   DateTime
  closesAt  DateTime
  createdAt DateTime @default(now())

  nominees  PollNominee[]
  votes     PollVote[]

  @@unique([country, type, year, month])
  @@index([closesAt])
}

model PollNominee {
  id       String @id @default(cuid())
  pollId   String
  uploadId String

  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@unique([pollId, uploadId])
  @@index([pollId])
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  nomineeId String
  userId    String
  createdAt DateTime @default(now())

  poll    Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  nominee PollNominee @relation(fields: [nomineeId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([nomineeId])
  @@index([userId])
}
