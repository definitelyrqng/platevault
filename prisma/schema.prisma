datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum NotificationType {
  LIKE
  COMMENT
  UPLOAD_DELETED
  UPLOAD_FLAGGED
  MULTISPOT
  POLL
  SYSTEM
  MENTION
  DM
  MILESTONE
  CHALLENGE
  STREAK
}

enum PollType {
  MONTHLY
  YEARLY
}

enum UserRole {
  SUPERADMIN  // user #0 only — created via CLI
  ADMIN
  MOD
  USER
}

model User {
  id        String   @id @default(cuid())
  numericId Int      @unique @default(autoincrement())
  role      UserRole @default(USER)

  username  String   @unique @db.VarChar(20)
  email     String   @unique @db.VarChar(254)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now())

  bio       String?  @db.VarChar(280)
  avatarUrl String?  @db.VarChar(500)
  bannerUrl String?  @db.VarChar(500)

  // Ban
  bannedAt     DateTime?
  banExpiresAt DateTime?          // null = permanent
  banReason    String?  @db.VarChar(500)

  // Pinned spots (up to 3 upload IDs)
  pinnedSpotIds   String[]  @default([])

  // Streaks
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastUploadDate  DateTime?

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  uploads             Upload[]
  likes               Like[]
  comments            Comment[]
  notifications       Notification[]
  pollVotes           PollVote[]
  companies           TransportCompany[]
  followers           Follow[]              @relation("Following")
  following           Follow[]              @relation("Follower")
  collections         Collection[]
  rareVotes           RareVote[]
  sentMessages        DirectMessage[]       @relation("Sender")
  receivedMessages    DirectMessage[]       @relation("Receiver")
  roadTrips           RoadTrip[]
  challengeCompletions ChallengeCompletion[]

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(128)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Upload {
  id        String   @id @default(cuid())
  numericId Int      @unique @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  country   String   @db.VarChar(60)
  plateText String   @db.VarChar(32)
  plateType String?  @db.VarChar(60)

  brand      String? @db.VarChar(60)
  model      String? @db.VarChar(60)
  generation String? @db.VarChar(60)
  trim       String? @db.VarChar(60)
  color      String? @db.VarChar(60)

  location     String?  @db.VarChar(120)
  plateRegion  String?  @db.VarChar(10)
  badge        String?  @db.VarChar(30)
  description  String?  @db.VarChar(1000)
  tags         String[] @default([])

  imageUrl  String   @db.VarChar(500)

  companyId  String?
  company    TransportCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  roadTripId String?
  roadTrip   RoadTrip?         @relation(fields: [roadTripId], references: [id], onDelete: SetNull)

  hidden    Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  likes            Like[]
  comments         Comment[]
  pollNominees     PollNominee[]
  collectionItems  CollectionItem[]
  rareVotes        RareVote[]

  @@index([userId, createdAt])
  @@index([country, createdAt])
  @@index([plateText])
  @@index([companyId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  uploadId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  upload    Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([userId, uploadId])
  @@index([uploadId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  uploadId  String
  userId    String
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  upload    Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([uploadId, createdAt])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String           @db.VarChar(120)
  message   String?          @db.VarChar(280)
  url       String?          @db.VarChar(500)

  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model TransportCompany {
  id          String   @id @default(cuid())
  numericId   Int      @unique @default(autoincrement())
  name        String   @db.VarChar(120)
  country     String?  @db.VarChar(60)
  city        String?  @db.VarChar(80)
  description String?  @db.VarChar(500)
  website     String?  @db.VarChar(200)
  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  uploads     Upload[]

  @@index([name])
  @@index([country])
}

model CarBrand {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  models    CarModel[]
  createdAt DateTime   @default(now())

  @@index([name])
}

model CarModel {
  id          Int             @id @default(autoincrement())
  name        String
  brandId     Int
  brand       CarBrand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  generations CarGeneration[]
  createdAt   DateTime        @default(now())

  @@unique([brandId, name])
  @@index([brandId])
}

model CarGeneration {
  id        Int      @id @default(autoincrement())
  name      String
  modelId   Int
  model     CarModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([modelId, name])
  @@index([modelId])
}

model Poll {
  id        String   @id @default(cuid())
  numericId Int      @unique @default(autoincrement())
  country   String   @db.VarChar(60)
  type      PollType
  year      Int
  month     Int      @default(0)  // 1-12 for MONTHLY, 0 for YEARLY
  opensAt   DateTime
  closesAt  DateTime
  createdAt DateTime @default(now())

  nominees  PollNominee[]
  votes     PollVote[]

  @@unique([country, type, year, month])
  @@index([closesAt])
}

model PollNominee {
  id       String @id @default(cuid())
  pollId   String
  uploadId String

  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@unique([pollId, uploadId])
  @@index([pollId])
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  nomineeId String
  userId    String
  createdAt DateTime @default(now())

  poll    Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  nominee PollNominee @relation(fields: [nomineeId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([nomineeId])
  @@index([userId])
}

// ─── Follow system ──────────────────────────────────────────────────────────

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("Follower",  fields: [followerId],  references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ─── Collections ────────────────────────────────────────────────────────────

model Collection {
  id          String   @id @default(cuid())
  numericId   Int      @unique @default(autoincrement())
  userId      String
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(280)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  uploadId     String
  addedAt      DateTime   @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  upload       Upload     @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([collectionId, uploadId])
  @@index([collectionId])
  @@index([uploadId])
}

// ─── Rare plate voting ───────────────────────────────────────────────────────

model RareVote {
  id        String   @id @default(cuid())
  userId    String
  uploadId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  upload    Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([userId, uploadId])
  @@index([uploadId])
  @@index([userId])
}

// ─── Direct messages ─────────────────────────────────────────────────────────

model DirectMessage {
  id          String    @id @default(cuid())
  numericId   Int       @unique @default(autoincrement())
  senderId    String
  receiverId  String
  content     String    @db.VarChar(2000)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender      User      @relation("Sender",   fields: [senderId],   references: [id], onDelete: Cascade)
  receiver    User      @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, createdAt])
}

// ─── Road trips ──────────────────────────────────────────────────────────────

model RoadTrip {
  id          String    @id @default(cuid())
  numericId   Int       @unique @default(autoincrement())
  userId      String
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploads     Upload[]

  @@index([userId])
}

// ─── Password reset ───────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique @db.VarChar(128)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

// ─── Weekly challenges ────────────────────────────────────────────────────────

model ChallengeCompletion {
  id           String   @id @default(cuid())
  userId       String
  challengeKey String   @db.VarChar(80)  // e.g. "2025-W22-spot5"
  completedAt  DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeKey])
  @@index([userId])
}
